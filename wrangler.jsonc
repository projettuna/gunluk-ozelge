// Cloudflare yayını: docs/ klasöründeki uygulama + worker/index.js (bildirim aktarıcısı)
{
  "name": "tmpro",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // GitHub'ın kendi zamanlayıcısı yoğun saatlerde turları atlıyor; taramaları bu tetikleyici başlatır (GH_DISPATCH_TOKEN sırrı gerekir)
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": { "directory": "./docs", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
